    {
      "id": "amazify.karaoke-lyrics",
      "trust": "stock",
      "repository": "eripum9/Amazify",
      "sourceCommit": "66a091a56b59939e2bfba5d8870d7bdc933e41ff",
      "pluginRoot": "sample_plugins/amazify.karaoke-lyrics",
      "minimumAmazifyVersion": "1.1.2",
      "manifest": {
        "id": "amazify.karaoke-lyrics",
        "name": "Karaoke Lyrics",
        "version": "0.2.4",
        "minimumAmazifyVersion": "1.1.2",
        "author": "Amazify",
        "type": "ui",
        "description": "Adds word and syllable highlighting when rich lyrics are available. Keeps your native lyrics and theme otherwise. No account required.",
        "entry": "plugin.js",
        "styles": [
          "base.css",
          "normal.css"
        ],
        "permissions": [
          "dom-read",
          "dom-write",
          "dom-style",
          "lyrics-provider"
        ],
        "settings": [
          {
            "id": "motion",
            "type": "select",
            "label": "Lyric motion",
            "description": "Word and syllable lifts, hover glow, and smooth lyric centering.",
            "default": "system",
            "options": [
              {
                "value": "system",
                "label": "Follow system"
              },
              {
                "value": "on",
                "label": "On"
              },
              {
                "value": "off",
                "label": "Off"
              }
            ]
          }
        ],
        "amazonMusic": {
          "testedAppVersions": [],
          "target": "desktop"
        }
      },

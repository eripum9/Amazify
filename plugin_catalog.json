    {
      "id": "amazify.true-big-mode",
      "trust": "stock",
      "repository": "eripum9/Amazify",
      "sourceCommit": "3d6ecbec6d154bd5c377e1e0a10e0c71f5774e6c",
      "pluginRoot": "sample_plugins/amazify.true-big-mode",
      "minimumAmazifyVersion": "1.1.2",
      "manifest": {
        "id": "amazify.true-big-mode",
        "name": "True Big Mode",
        "version": "0.2.3",
        "author": "Amazify",
        "type": "ui",
        "description": "Turns Amazon Music Big Mode into a cleaner full-screen lyrics view with album-art exit behavior.",
        "entry": "plugin.js",
        "styles": [
          "style.css"
        ],
        "permissions": [
          "dom-read",
          "dom-write",
          "dom-style"
        ],
        "minimumAmazifyVersion": "1.1.2",
        "settings": [
          {
            "id": "showLyrics",
            "type": "boolean",
            "label": "Show lyrics",
            "description": "Show lyrics beside the artwork. When off, center the artwork and suspend Karaoke Lyrics while True Big Mode is open.",
            "default": true
          },
          {
            "id": "autoFullscreen",
            "type": "boolean",
            "label": "Enter fullscreen automatically",
            "description": "Enter fullscreen when True Big Mode opens. Turn off to return to the window; browsers may require a user gesture.",
            "default": false
          }
        ],
        "amazonMusic": {
          "testedAppVersions": [],
          "target": "desktop"
        }
      },
      "files": [
        {
          "path": "manifest.json",

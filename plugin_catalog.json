          "dom-write",
          "dom-style"
        ],
        "minimumAmazifyVersion": "1.1.0",
        "settings": [
          {
            "id": "primaryColor",
            "type": "color",
            "label": "Main color",
            "description": "Active navigation, playback progress, and primary highlights.",
            "default": "#d9ff43"
          },
          {
            "id": "secondaryColor",
            "type": "color",
            "label": "Secondary color",
            "description": "Hover states, secondary highlights, warnings, and gradients.",

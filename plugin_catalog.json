    {
      "id": "amazify.karaoke-lyrics",
      "trust": "stock",
      "repository": "eripum9/Amazify",
      "sourceCommit": "3d6ecbec6d154bd5c377e1e0a10e0c71f5774e6c",
      "pluginRoot": "sample_plugins/amazify.karaoke-lyrics",
      "minimumAmazifyVersion": "1.1.2",
      "manifest": {
        "id": "amazify.karaoke-lyrics",
        "name": "Karaoke Lyrics",
        "version": "0.2.5",
        "minimumAmazifyVersion": "1.1.2",
        "author": "Amazify",
        "type": "ui",
        "description": "Adds word and syllable highlighting when rich lyrics are available. Keeps your native lyrics and theme otherwise. No account required.",
        "entry": "plugin.js",
        "styles": [
          "base.css",
          "normal.css"
        ],
        "permissions": [
          "dom-read",
          "dom-write",
          "dom-style",
          "lyrics-provider"
        ],
        "settings": [
          {
            "id": "motion",
            "type": "select",
            "label": "Lyric motion",
            "description": "Word and syllable lifts, hover glow, and smooth lyric centering.",
            "default": "system",
            "options": [
              {
                "value": "system",
                "label": "Follow system"
              },
              {
                "value": "on",
                "label": "On"
              },
              {
                "value": "off",
                "label": "Off"
              }
            ]
          }
        ],
        "amazonMusic": {
          "testedAppVersions": [],
          "target": "desktop"
        }
      },
